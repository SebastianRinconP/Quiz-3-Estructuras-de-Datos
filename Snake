public class Snake {
    
    private DynamicArray<Integer> cuerpo = new DynamicArray<>(4);
    private int head;
    private int tail;
    
    public SnakeEstudiante (){
        tail = cuerpo[0];
        head = cuerpo[cuerpo.size()-1]
    }
    
    public void ComioFruta(){
        cuerpo.append(cuerpo.size()-1);
        head = cuerpo[cuerpo.size()-1]; //Ya esta definido que aumente el size en la operacion interna
    }
}
